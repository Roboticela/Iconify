{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iconify",
  "version": "0.1.0",
  "identifier": "com.roboticela.iconify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Iconify",
        "width": 1200,
        "height": 800,
        "center": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Roboticela",
    "copyright": "© ${currentYear} Roboticela. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Icon generation and management for all platforms",
    "longDescription": "A comprehensive icon generation and management tool for creating platform-specific icons (iOS, Android, PWA, desktop). Built with Tauri, React, and Rust for optimal performance.",
    "homepage": "https://iconify.roboticela.com",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "iOS": {},
    "android": {}
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}